# Copy these into Vercel Environment Variables. Keep this file private.
NUMBER_API_BASE=
AADHAAR_API_BASE=

# UPI payment ID
UPI_ID=
NEXT_PUBLIC_UPI_ID=

# Admin
ADMIN_EMAIL=lumenomore@hotmail.com

# Production auth redirect. Set this to your Vercel production URL, e.g. https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase (free tier)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (use Gmail App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Dbweb
